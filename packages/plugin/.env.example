# Comma-separated bridge origins, one per machine (https://<machine>.<tailnet>.ts.net via `tailscale serve`).
# app.json's network whitelist is generated from this. http:// origins work in dev only.
VITE_BRIDGE_ORIGINS=https://mbp.tail1234.ts.net,https://linux-box.tail1234.ts.net

# Optional build-time Deepgram key for dictation (the phone page field overrides it). Embedded in the bundle: personal sideload only.
# VITE_DEEPGRAM_API_KEY=
