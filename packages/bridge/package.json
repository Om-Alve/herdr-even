{
  "name": "@herdr-even/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "HERDR_EVEN_DEV_NOAUTH=1 bun --watch src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun scripts/smoke.ts",
    "build": "bun build --compile src/main.ts --outfile dist/herdr-even"
  },
  "dependencies": {
    "@herdr-even/protocol": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
